# .env.example – copy to .env and fill in real values

# Flask secret key (64‑hex characters)
SECRET_KEY=your_secret_key_here

# Database URL (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite:///cotton_green.db

# Model file path
MODEL_PATH=./model/final_model.keras

# Redis URL for caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# CORS allowed origins (comma‑separated list). Use * for development.
CORS_ALLOWED_ORIGINS=*

# Flask environment (development / production)
FLASK_ENV=development
